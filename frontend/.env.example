# Copy to frontend/.env — must match KALSHI_API_BEARER_TOKEN in repo root .env if API bearer auth is enabled.
# VITE_API_BEARER_TOKEN=

# If the API runs on a non-default port or host, point the Vite dev proxy at it (see vite.config.ts).
# VITE_API_ORIGIN=http://127.0.0.1:8765

# Optional: label next to the app title (`dev` = develop, `main`/`live` = main worktree).
# If omitted: from dev URL port (5173 = main, 5174 = develop), else VITE_API_ORIGIN 8770 → main, else develop.
# VITE_UI_TRACK=dev
