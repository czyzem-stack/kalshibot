# Copy to frontend/.env — must match KALSHI_API_BEARER_TOKEN in repo root .env if API bearer auth is enabled.
# VITE_API_BEARER_TOKEN=

# If the API runs on a non-default port or host, point the Vite dev proxy at it (see vite.config.ts).
# VITE_API_ORIGIN=http://127.0.0.1:8765

# Optional: label next to the app title when the dev URL port is not a known convention (see uiTrack.ts).
# In `vite dev`, port wins if it is 5173 (main), 5174 (develop), or 5175 (test) — avoids :5174 and :5175 both showing “dev”.
# Otherwise: VITE_UI_TRACK=dev|main|test|live, then VITE_API_ORIGIN :8770 → main, else develop.
# VITE_UI_TRACK=dev
