# Copy to .env in this folder and fill in. Restart the backend after changes.
# Docs: https://docs.kalshi.com/getting_started/api_keys

# API logging: LOG_JSON=1 in Docker/prod (one line per log); LOG_LEVEL=DEBUG|INFO|WARNING|…
LOG_JSON=0
LOG_LEVEL=INFO

# Log FastAPI startup phase timings to help tune cold start (http pool, engines, /markets pre-warm).
# KALSHI_PROFILE_STARTUP=0
# Wider in-memory /markets and orderbook TTL for a few seconds; steady values follow.
# KALSHI_COLD_START_CACHE_TTL_S=90
# KALSHI_OPEN_MARKETS_TTL_S=10
# KALSHI_ORDERBOOK_TTL_S=10

# PHASE 2: optional Kalshi WebSocket (orderbook deltas + ticker). REST + cache remain fallback.
# KALSHI_WS_ENABLED=0
# KALSHI_WS_MAX_MARKETS=120
# KALSHI_WS_SUBSCRIBE_CHUNK=40
# KALSHI_WS_RECONNECT_CAP_S=60
# Log dual_engine_loop wall time + WS/cache stats every N seconds (0 = off).
# KALSHI_LOG_TICK_INTERVAL_S=0

# PHASE 3 advanced tuning (defaults preserve current behavior; optional for power users).
# KALSHI_HTTP_TIMEOUT_S=30
# KALSHI_HTTP_CONNECT_TIMEOUT_S=15
# KALSHI_HTTP_MAX_CONNECTIONS=40
# KALSHI_HTTP_MAX_KEEPALIVE_CONNECTIONS=20
# KALSHI_PRIVATE_CALL_CONCURRENCY=3
# KALSHI_PUBLIC_MAX_ATTEMPTS=8
# KALSHI_PRIVATE_MAX_ATTEMPTS=8
# KALSHI_429_BACKOFF_BASE_S=1.8
# KALSHI_429_BACKOFF_CAP_S=55
# KALSHI_429_JITTER_S=0.6
# KALSHI_5XX_BACKOFF_BASE_S=0.4
# KALSHI_5XX_BACKOFF_CAP_S=8
# KALSHI_WS_PING_INTERVAL_S=20
# KALSHI_WS_PING_TIMEOUT_S=45
# KALSHI_WS_CLOSE_TIMEOUT_S=5
# KALSHI_WS_RECV_TIMEOUT_S=1
# KALSHI_WS_NO_TICKER_SLEEP_S=15
# KALSHI_WS_RECONNECT_BASE_S=1
# KALSHI_WS_RECONNECT_MULTIPLIER=1.8
# KALSHI_WS_RECONNECT_JITTER_S=0.35
# KALSHI_PREWARM_MAX_CONCURRENT=4
# KALSHI_STARTUP_RESTORE_TTLS_DELAY_S=8
# KALSHI_LAB_TICK_STAGGER_S=0.45
# DASHBOARD_ORDERBOOK_CACHE_TTL_S=5
# ENGINE_STUDY_TRADE_WINDOW_MINUTES=15
# ENGINE_ORDERBOOK_ENRICH_FIRST_TICK_CAP=10
# ENGINE_ORDERBOOK_ENRICH_STEADY_CAP=20
# PHASE FINAL engine/loop config fallbacks (defaults match prior behavior when config fields are absent).
# DEFAULT_POLL_SECONDS=8
# DEFAULT_WINDOW_MINUTES=15
# DEFAULT_BALANCE_FRACTION_PER_WINDOW=0.03
# DEFAULT_MIN_CONTRACTS=1
# DEFAULT_PAPER_BALANCE_CENTS=500000
# DEFAULT_AUTO_CLOSE_OPEN_SIM_MINUTES=75

# demo = https://demo-api.kalshi.co  |  prod = https://api.elections.kalshi.com
KALSHI_ENV=demo

KALSHI_API_KEY_ID=

# Use either a PEM file path OR inline PEM (use \n for newlines in PEM if one line).
KALSHI_PRIVATE_KEY_PATH=
# KALSHI_PRIVATE_KEY_PEM=

# Optional: load PEM from OS keyring (after `pip install keyring`). Set service/user or use defaults below.
# KALSHI_USE_KEYRING=0
# KALSHI_KEYRING_SERVICE=kalshibot
# KALSHI_KEYRING_USERNAME=KALSHI_PRIVATE_KEY_PEM

# Optional API auth: when set, all /api/* except /api/health* require `Authorization: Bearer <token>`.
# Set the same value in frontend/.env as VITE_API_BEARER_TOKEN so the dashboard can call the API.
# KALSHI_API_BEARER_TOKEN=

# CORS: comma-separated exact origins (default Vite dev). For production, set to your dashboard origin only.
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional: if port 8765 is in use on Windows
# KALSHI_BOT_PORT=8080

# Frontend (Vite): proxy /api to the same host:port as the backend. Defaults to 8765.
# Create frontend/.env with e.g. VITE_API_ORIGIN=http://127.0.0.1:8080 when KALSHI_BOT_PORT is 8080.
# VITE_API_ORIGIN=http://127.0.0.1:8765

# SQLite DB (default: data/bot.sqlite3 under this checkout). Relative SQLITE_PATH / DATA_LOG_DIR
# are resolved from the repo root (not cwd), so parallel worktrees stay on separate files.
# SQLITE_PATH=

# Append-only JSONL logs on disk (signals, trades, system). Default: data/logs
# DATA_LOG_DIR=data/logs
# DATA_LOGGING=1
# DATA_LOG_EQUITY=0

# If set, POST /api/data/reset also requires header: X-Reset-Token: <same value>
# DATA_RESET_TOKEN=

# Anthropic API key for scheduled optimizer runs (Lab A/B only analysis)
# ANTHROPIC_API_KEY=

# Optional: POST when an engine branch gets a new ``last_error`` (Discord incoming webhook: JSON body uses "content"; Slack hooks.slack.com uses "text").
# ALERT_WEBHOOK_URL=
# Minimum seconds between duplicate (branch + error prefix) posts (default 120).
# ALERT_WEBHOOK_MIN_SECONDS=120
